{
  "name": "ivy-trace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:mock": "pnpm --filter @ivy/ui dev:mock",
    "build": "pnpm -r build",
